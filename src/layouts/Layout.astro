---
import '../styles/global.css';
import { site } from '../data/site';

interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
  noindex?: boolean;
}

const {
  title,
  description = site.description,
  ogImage = site.ogImage,
  noindex = false,
} = Astro.props;

const pageTitle = title ? `${title} · ${site.name}` : `${site.name} · ${site.tagline}`;
const canonical = new URL(Astro.url.pathname, Astro.site ?? site.url).toString();
---

<!doctype html>
<html lang={site.locale} data-theme="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="color-scheme" content="dark light" />

    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}

    <meta property="og:type" content="website" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={new URL(ogImage, Astro.site ?? site.url).toString()} />
    <meta property="og:locale" content="en_US" />
    <meta property="og:site_name" content={site.name} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={new URL(ogImage, Astro.site ?? site.url).toString()} />

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="generator" content={Astro.generator} />

    <script is:inline>
      // Theme pre-flash guard. The site is dark-first by design (editorial
      // dark + amber); light is an explicit opt-in via the toggle, NOT the
      // OS preference. So default to dark and only honor an explicit stored
      // choice — this also avoids the jarring always-dark-hero / light-body
      // split for visitors whose OS is set to light mode.
      (function () {
        try {
          var stored = localStorage.getItem('theme');
          document.documentElement.dataset.theme = stored === 'light' ? 'light' : 'dark';
        } catch (_) {
          document.documentElement.dataset.theme = 'dark';
        }
      })();
    </script>
  </head>
  <body class="grain">
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:fixed focus:top-4 focus:left-4 focus:z-50 focus:bg-accent focus:text-bg focus:px-4 focus:py-2 focus:font-mono focus:text-sm focus:rounded"
    >
      Skip to content
    </a>
    <slot />

    <script is:inline>
      // Robust same-page anchor navigation. Native hash-scroll and the
      // browser's CSS smooth-scroll are unreliable on this page — the
      // continuous WebGL render loop (aurora + lanyard) starves the
      // scroll animation so nav links / hero CTAs appeared dead. A
      // delegated handler using scrollIntoView() is deterministic here
      // (the same call drives the section reveals reliably).
      (function () {
        document.addEventListener(
          'click',
          function (e) {
            var a = e.target && e.target.closest
              ? e.target.closest('a[href^="#"]')
              : null;
            if (!a) return;
            var hash = a.getAttribute('href');
            if (!hash || hash === '#') return;
            var id = decodeURIComponent(hash.slice(1));
            var target = document.getElementById(id);
            if (!target) return;
            e.preventDefault();
            // Instant, not smooth: the browser's smooth-scroll engine
            // (native or JS) gets starved by the continuous WebGL render
            // loop and stalls mid-scroll. Instant is 100% reliable here.
            target.scrollIntoView({ behavior: 'auto', block: 'start' });
            // Reflect the hash without triggering the native jump.
            if (history.replaceState) {
              history.replaceState(null, '', hash);
            }
          },
          false
        );
      })();
    </script>
  </body>
</html>
