---
import { featuredProjects, supportingProjects } from '../../data/projects';
---

<section id="work" class="relative px-6 py-32 md:px-12 md:py-48">
  <div class="mx-auto max-w-[1400px]">
    <header class="mb-20 flex flex-wrap items-end justify-between gap-6 border-b border-border-subtle pb-8">
      <div>
        <p class="eyebrow mb-4">
          <span class="text-accent">§</span> Section 01 — Work
        </p>
        <h2 class="font-display font-light leading-[0.95] tracking-tight" style="font-size: var(--text-display-2);">
          Six projects<br />on the table<span class="text-accent">.</span>
        </h2>
      </div>
      <p class="max-w-md text-muted-fg">
        From a multi-tenant SaaS running live in Ecuador to a published swarm-robot platform built in Brussels. Click any tile for the case study.
      </p>
    </header>

    {/* Featured row */}
    <div class="grid gap-8 md:grid-cols-2 md:gap-12">
      {
        featuredProjects.map((p, i) => (
          <a
            href={`#project-${p.slug}`}
            class="group relative block overflow-hidden rounded-2xl border border-border-subtle bg-surface p-8 transition-colors hover:border-accent md:p-10"
          >
            <div class="mb-6 flex items-center justify-between font-mono text-[11px] uppercase tracking-[0.18em] text-muted-fg">
              <span class="text-accent">N°0{i + 1}</span>
              <span class="rounded-full border border-border-subtle px-2 py-1">
                {p.status}
              </span>
            </div>
            <h3 class="font-display text-4xl font-light tracking-tight md:text-5xl">
              {p.title}
              <span class="text-accent">.</span>
            </h3>
            <p class="mt-4 max-w-prose text-base text-fg/80 md:text-lg">
              {p.tagline}
            </p>
            <ul class="mt-6 flex flex-wrap gap-2 font-mono text-[10px] uppercase tracking-[0.18em] text-muted-fg">
              {p.stack.slice(0, 5).map((s) => (
                <li class="rounded-full border border-border-subtle px-3 py-1">{s}</li>
              ))}
            </ul>
            {p.ai && (
              <span class="absolute right-6 top-6 rounded-full px-2 py-1 font-mono text-[10px] uppercase tracking-[0.18em]" style="background-color: var(--color-accent); color: var(--color-bg);">
                AI
              </span>
            )}
          </a>
        ))
      }
    </div>

    {/* Supporting cards row */}
    <div class="mt-12 grid gap-6 md:mt-16 md:grid-cols-2 lg:grid-cols-4">
      {
        supportingProjects.map((p, i) => (
          <a
            href={`#project-${p.slug}`}
            class="group block rounded-xl border border-border-subtle bg-surface p-6 transition-colors hover:border-accent"
          >
            <div class="mb-4 flex items-center justify-between font-mono text-[10px] uppercase tracking-[0.18em] text-muted-fg">
              <span class="text-accent">N°0{i + 3}</span>
              <span>{p.year}</span>
            </div>
            <h3 class="font-display text-2xl font-light tracking-tight">{p.title}</h3>
            <p class="mt-3 text-sm text-fg/70">{p.tagline}</p>
          </a>
        ))
      }
    </div>
  </div>
</section>
