---

<section id="experience" class="relative px-6 py-32 md:px-12 md:py-48">
  <div class="mx-auto max-w-[1400px]">
    <header class="mb-20 flex flex-wrap items-end justify-between gap-6 border-b border-border-subtle pb-8">
      <div>
        <p class="eyebrow mb-4">
          <span class="text-accent">§</span> Section 03 — Experience
        </p>
        <h2 class="font-display font-light leading-[0.95] tracking-tight" style="font-size: var(--text-display-2);">
          The timeline<span class="text-accent">.</span>
        </h2>
      </div>
      <a
        href="/Cristobal_Lara_Resume.pdf"
        class="inline-flex items-center gap-3 rounded-full border border-border-subtle px-5 py-3 font-mono text-xs uppercase tracking-[0.18em] text-fg transition-colors hover:border-accent hover:text-accent"
      >
        Download CV ↓
      </a>
    </header>

    <ol class="space-y-12">
      {
        items.map((it, i) => (
          <li class="grid gap-4 border-b border-border-subtle pb-12 last:border-0 md:grid-cols-12 md:gap-8">
            <div class="font-mono text-xs uppercase tracking-[0.18em] text-muted-fg md:col-span-2">
              <span class="text-accent">0{i + 1}</span>
              <span class="mx-2">/</span>
              {it.when}
            </div>
            <div class="md:col-span-4">
              <p class="font-display text-2xl font-light tracking-tight">{it.org}</p>
              <p class="mt-1 text-sm text-muted-fg">{it.where}</p>
            </div>
            <div class="md:col-span-6">
              <p class="text-lg text-fg">{it.role}</p>
              <p class="mt-2 text-muted-fg">{it.note}</p>
            </div>
          </li>
        ))
      }
    </ol>
  </div>
</section>
