---
import { site } from '../../data/site';
---

<section id="contact" class="relative px-6 py-32 md:px-12 md:py-48">
  <div class="mx-auto max-w-[1400px]">
    <p class="eyebrow mb-4">
      <span class="text-accent">§</span> Section 04 — Contact
    </p>
    <h2 class="font-display font-light leading-[0.9] tracking-tight" style="font-size: var(--text-display-1);">
      Let's talk<span class="text-accent">.</span>
    </h2>
    <p class="mt-10 max-w-2xl text-xl text-fg/85">
      I'm actively looking for full-stack, frontend, backend, cloud, or AI-engineering roles in Vancouver — mid to senior, 75K+ CAD. Open to remote across Canada.
    </p>

    <div class="mt-16 grid gap-6 md:grid-cols-3">
      <a
        href={`mailto:${site.email}`}
        class="group flex items-center justify-between rounded-2xl border border-border-subtle bg-surface p-8 transition-colors hover:border-accent"
      >
        <div>
          <p class="eyebrow mb-2 text-accent">Email</p>
          <p class="font-mono text-sm md:text-base">{site.email}</p>
        </div>
        <span aria-hidden class="font-mono text-2xl transition-transform group-hover:translate-x-1 group-hover:text-accent">→</span>
      </a>
      <a
        href={site.socials.linkedin}
        target="_blank"
        rel="noopener"
        class="group flex items-center justify-between rounded-2xl border border-border-subtle bg-surface p-8 transition-colors hover:border-accent"
      >
        <div>
          <p class="eyebrow mb-2 text-accent">LinkedIn</p>
          <p class="font-mono text-sm md:text-base">in/cristobal-lara</p>
        </div>
        <span aria-hidden class="font-mono text-2xl transition-transform group-hover:translate-x-1 group-hover:text-accent">→</span>
      </a>
      <a
        href={site.socials.github}
        target="_blank"
        rel="noopener"
        class="group flex items-center justify-between rounded-2xl border border-border-subtle bg-surface p-8 transition-colors hover:border-accent"
      >
        <div>
          <p class="eyebrow mb-2 text-accent">GitHub</p>
          <p class="font-mono text-sm md:text-base">github.com/crilver</p>
        </div>
        <span aria-hidden class="font-mono text-2xl transition-transform group-hover:translate-x-1 group-hover:text-accent">→</span>
      </a>
    </div>

    <footer class="mt-24 flex flex-wrap items-end justify-between gap-6 border-t border-border-subtle pt-8 font-mono text-xs uppercase tracking-[0.18em] text-muted-fg">
      <p>
        © 2026 Cristobal Lara <span class="text-accent">·</span> Vancouver, BC
      </p>
      <p>
        Built with Astro, React, Tailwind <span class="text-accent">·</span> hosted on Cloudflare
      </p>
    </footer>
  </div>
</section>
