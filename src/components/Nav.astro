---
import { nav, site } from '../data/site';
import ThemeToggle from './ThemeToggle.tsx';
---

<header
  id="site-nav"
  class="fixed inset-x-0 top-0 z-40 transition-[background-color,backdrop-filter] duration-300"
  data-scrolled="false"
>
  <div class="mx-auto flex max-w-[1400px] items-center justify-between px-6 py-4 md:px-12 md:py-6">
    <a
      href="/"
      class="font-display text-xl font-medium tracking-tight transition-colors hover:text-accent"
    >
      Cristobal Lara
      <span class="text-accent">.</span>
    </a>

    <nav aria-label="Primary" class="hidden items-center gap-8 md:flex">
      {
        nav.map((item) => (
          <a
            href={item.href}
            class="font-mono text-xs uppercase tracking-[0.18em] text-muted-fg transition-colors hover:text-fg"
          >
            {item.label}
          </a>
        ))
      }
    </nav>

    <div class="flex items-center gap-3">
      <a
        href={site.cvHref}
        target="_blank"
        rel="noopener noreferrer"
        class="hidden items-center gap-2 rounded-full border border-border-subtle px-4 py-2 font-mono text-xs uppercase tracking-[0.18em] text-fg transition-all hover:border-accent hover:text-accent md:inline-flex"
      >
        Resume
        <svg
          width="12"
          height="12"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"></path>
          <polyline points="15 3 21 3 21 9"></polyline>
          <line x1="10" y1="14" x2="21" y2="3"></line>
        </svg>
      </a>
      <ThemeToggle client:idle />
    </div>
  </div>
</header>

<style>
  /* Transparent at top of page so the lanyard's rope reads cleanly over
     the navbar. Backdrop + bg kick in only once the user scrolls down
     past 20px, so the nav stays legible against varied page content. */
  #site-nav[data-scrolled='true'] {
    background-color: color-mix(in oklab, var(--color-bg) 78%, transparent);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
  }
</style>

<script is:inline>
  (() => {
    const nav = document.getElementById('site-nav');
    if (!nav) return;
    let raf = 0;
    const update = () => {
      nav.dataset.scrolled = window.scrollY > 20 ? 'true' : 'false';
    };
    const onScroll = () => {
      cancelAnimationFrame(raf);
      raf = requestAnimationFrame(update);
    };
    update();
    window.addEventListener('scroll', onScroll, { passive: true });
  })();
</script>
