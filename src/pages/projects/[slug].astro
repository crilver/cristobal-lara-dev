---
import Layout from '../../layouts/Layout.astro';
import Nav from '../../components/Nav.astro';
import { projects } from '../../data/projects';
import { caseStudies } from '../../data/case-studies';
import { site } from '../../data/site';

export function getStaticPaths() {
  return projects.map((project, index) => ({
    params: { slug: project.slug },
    props: { project, index },
  }));
}

const { project, index } = Astro.props;
const study = caseStudies[project.slug];

const n = projects.length;
const num = String(index + 1).padStart(2, '0');
const prev = projects[(index - 1 + n) % n];
const next = projects[(index + 1) % n];

// Build the outbound-link list from projects.ts links + case-study extras.
type OutLink = { label: string; href: string };
const links: OutLink[] = [];
if (project.links?.live) links.push({ label: 'Live site', href: project.links.live });
if (project.links?.repo) links.push({ label: 'Repository', href: project.links.repo });
if (project.links?.paper) links.push({ label: 'Paper', href: project.links.paper });
if (study?.links) for (const l of study.links) links.push(l);

// AeroAnalytics' visual is the demo video below (poster = dark.webp), so
// it intentionally has no separate static hero image.
const heroImage = project.slug === 'coravet' ? '/coravet/dashboard.webp' : null;

const metaDescription = `${project.title}: ${project.tagline}`;

// BreadcrumbList structured data (Home › Work › Project) for rich results.
const ldEscape = (obj: unknown) => JSON.stringify(obj).replace(/</g, '\\u003c');
const breadcrumbLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: `${site.url}/` },
    { '@type': 'ListItem', position: 2, name: 'Work', item: `${site.url}/#work` },
    {
      '@type': 'ListItem',
      position: 3,
      name: project.title,
      item: `${site.url}/projects/${project.slug}/`,
    },
  ],
};

// VideoObject structured data. Without it Google has no video metadata at
// all and reports the demo as unindexable ("video isn't on a watch page").
const videoLd =
  study?.demoVideo && study.demoVideoMeta
    ? {
        '@context': 'https://schema.org',
        '@type': 'VideoObject',
        name: study.demoVideoMeta.name,
        description: study.demoVideoMeta.description,
        thumbnailUrl: new URL(study.demoVideoMeta.thumbnail, site.url).toString(),
        contentUrl: new URL(study.demoVideo, site.url).toString(),
        uploadDate: study.demoVideoMeta.uploadDate,
      }
    : null;
---

<Layout title={project.title} description={metaDescription}>
  <script
    slot="head"
    type="application/ld+json"
    is:inline
    set:html={ldEscape(breadcrumbLd)}
  />
  {
    videoLd && (
      <script slot="head" type="application/ld+json" is:inline set:html={ldEscape(videoLd)} />
    )
  }
  <Nav />

  <main id="main" class="bg-bg text-fg">
    <article class="mx-auto max-w-[1100px] px-6 pb-24 pt-32 md:px-12 md:pt-36">
      {/* Back link */}
      <a
        href="/#work"
        class="group inline-flex items-center gap-2 font-mono text-xs uppercase tracking-[0.18em] text-muted-fg transition-colors hover:text-accent"
      >
        <span aria-hidden class="transition-transform group-hover:-translate-x-1">←</span>
        Selected work
      </a>

      {/* Hero */}
      <header class="mt-10 border-b border-border-subtle pb-12">
        <p class="eyebrow mb-6">
          <span class="text-accent">//</span> Case study · N°{num}
        </p>
        <h1
          class="font-display font-light leading-[0.95] tracking-tight"
          style="font-size: var(--text-display-2)"
        >
          {project.title}<span class="text-accent">.</span>
        </h1>
        <p class="mt-6 max-w-2xl text-lg text-fg/85 md:text-xl">{project.tagline}</p>

        <dl
          class="mt-10 grid grid-cols-2 gap-6 font-mono text-xs uppercase tracking-[0.16em] sm:grid-cols-4"
        >
          <div>
            <dt class="text-muted-fg">Role</dt>
            <dd class="mt-1 text-fg">{project.role}</dd>
          </div>
          <div>
            <dt class="text-muted-fg">Year</dt>
            <dd class="mt-1 text-fg">{project.year}</dd>
          </div>
          <div>
            <dt class="text-muted-fg">Status</dt>
            <dd class="mt-1 text-accent">{project.status}</dd>
          </div>
          <div>
            <dt class="text-muted-fg">Stack</dt>
            <dd class="mt-1 text-fg">{project.stack.slice(0, 3).join(' · ')}</dd>
          </div>
        </dl>

        {
          links.length > 0 && (
            <div class="mt-8 flex flex-wrap gap-3">
              {links.map((l) => (
                <a
                  href={l.href}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="inline-flex items-center gap-2 rounded-full border border-border-subtle px-5 py-2.5 font-mono text-xs uppercase tracking-[0.18em] text-fg transition-colors hover:border-accent hover:text-accent"
                >
                  {l.label}
                  <span aria-hidden>↗</span>
                </a>
              ))}
            </div>
          )
        }
      </header>

      {
        study ? (
          <>
            {/* Intro lead */}
            <p class="mt-12 max-w-3xl text-xl leading-relaxed text-fg/90 md:text-2xl">
              {study.intro}
            </p>

            {/* Optional hero image */}
            {heroImage && (
              <img
                src={heroImage}
                alt={`${project.title} interface`}
                loading="lazy"
                decoding="async"
                class="mt-12 w-full rounded-2xl border border-border-subtle"
              />
            )}

            {/* Demo video — self-hosted native <video>. Volume is forced to
                15% on load by the inline script below (browser autoplay
                policy still requires the user to press play). */}
            {study.demoVideo && (
              <section class="mt-12">
                <p class="eyebrow mb-4">
                  <span class="text-accent">//</span> Demo
                </p>
                <div
                  class="relative w-full overflow-hidden rounded-2xl border border-border-subtle bg-black"
                  style="aspect-ratio: 16 / 9;"
                >
                  <video
                    id="demo-video"
                    src={study.demoVideo}
                    poster={study.demoVideoMeta?.thumbnail}
                    controls
                    playsinline
                    preload="metadata"
                    class="absolute inset-0 h-full w-full object-contain"
                  >
                  </video>
                </div>
                <script is:inline>
                  (function () {
                    const v = document.getElementById('demo-video');
                    if (!v) return;
                    const DEFAULT_VOL = 0.15;
                    const set = function () {
                      try {
                        v.volume = DEFAULT_VOL;
                      } catch {}
                    };
                    set();
                    v.addEventListener('loadedmetadata', set, { once: true });
                  })();
                </script>
              </section>
            )}

            {/* Context */}
            <section class="mt-16 max-w-3xl">
              <p class="eyebrow mb-4">
                <span class="text-accent">//</span> Context
              </p>
              <p class="text-lg leading-relaxed text-fg/80">{study.context}</p>
            </section>

            {/* Highlights */}
            <section class="mt-12 grid grid-cols-2 gap-px overflow-hidden rounded-2xl border border-border-subtle bg-border-subtle md:grid-cols-4">
              {study.highlights.map((h) => (
                <div class="bg-surface p-6">
                  <p class="font-mono text-[10px] uppercase tracking-[0.18em] text-muted-fg">
                    {h.label}
                  </p>
                  <p class="mt-2 font-display text-lg font-light tracking-tight text-fg">
                    {h.value}
                  </p>
                </div>
              ))}
            </section>

            {/* Body sections */}
            {study.sections.map((s) => (
              <section class="mt-16 max-w-3xl">
                <h2 class="font-display text-2xl font-light tracking-tight text-fg md:text-3xl">
                  {s.heading}
                  <span class="text-accent">.</span>
                </h2>
                {s.body?.map((p) => (
                  <p class="mt-5 text-lg leading-relaxed text-fg/80">{p}</p>
                ))}
                {s.bullets && (
                  <ul class="mt-6 space-y-3">
                    {s.bullets.map((b) => (
                      <li class="flex gap-3 text-fg/80">
                        <span aria-hidden class="mt-2 h-1.5 w-1.5 shrink-0 rounded-full bg-accent" />
                        <span class="leading-relaxed">{b}</span>
                      </li>
                    ))}
                  </ul>
                )}
              </section>
            ))}

            {/* Contributions */}
            {study.contributions && (
              <section class="mt-16 max-w-3xl">
                <h2 class="font-display text-2xl font-light tracking-tight text-fg md:text-3xl">
                  What I did<span class="text-accent">.</span>
                </h2>
                <ul class="mt-6 space-y-3">
                  {study.contributions.map((c) => (
                    <li class="flex gap-3 text-fg/80">
                      <span aria-hidden class="mt-2 h-1.5 w-1.5 shrink-0 rounded-full bg-accent" />
                      <span class="leading-relaxed">{c}</span>
                    </li>
                  ))}
                </ul>
              </section>
            )}

            {/* Decisions */}
            {study.decisions && (
              <section class="mt-16 max-w-3xl">
                <h2 class="font-display text-2xl font-light tracking-tight text-fg md:text-3xl">
                  Notable decisions<span class="text-accent">.</span>
                </h2>
                <div class="mt-6 space-y-6">
                  {study.decisions.map((d) => (
                    <div class="rounded-xl border border-border-subtle bg-surface p-6">
                      <p class="font-mono text-xs uppercase tracking-[0.16em] text-accent">
                        {d.title}
                      </p>
                      <p class="mt-3 leading-relaxed text-fg/80">{d.body}</p>
                    </div>
                  ))}
                </div>
              </section>
            )}
          </>
        ) : (
          <p class="mt-12 text-lg text-muted-fg">Case study coming soon.</p>
        )
      }

      {/* Prev / next */}
      <nav
        aria-label="More work"
        class="mt-24 flex items-stretch justify-between gap-6 border-t border-border-subtle pt-10"
      >
        <a
          href={`/projects/${prev.slug}/`}
          class="group flex-1 rounded-xl border border-border-subtle p-6 transition-colors hover:border-accent"
        >
          <span class="font-mono text-[10px] uppercase tracking-[0.18em] text-muted-fg">
            ← Previous
          </span>
          <p class="mt-2 font-display text-xl font-light tracking-tight text-fg group-hover:text-accent">
            {prev.title}
          </p>
        </a>
        <a
          href={`/projects/${next.slug}/`}
          class="group flex-1 rounded-xl border border-border-subtle p-6 text-right transition-colors hover:border-accent"
        >
          <span class="font-mono text-[10px] uppercase tracking-[0.18em] text-muted-fg">
            Next →
          </span>
          <p class="mt-2 font-display text-xl font-light tracking-tight text-fg group-hover:text-accent">
            {next.title}
          </p>
        </a>
      </nav>

      {/* Footer */}
      <footer
        class="mt-16 flex flex-wrap items-end justify-between gap-6 border-t border-border-subtle pt-8 font-mono text-xs uppercase tracking-[0.18em] text-muted-fg"
      >
        <a href="/#work" class="transition-colors hover:text-accent">
          ← All work
        </a>
        <a href={`mailto:${site.email}`} class="transition-colors hover:text-accent">
          {site.email}
        </a>
      </footer>
    </article>
  </main>
</Layout>
