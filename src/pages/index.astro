---
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import Hero from '../components/sections/Hero.tsx';
import Work from '../components/sections/Work.tsx';
import About from '../components/sections/About.tsx';
import Experience from '../components/sections/Experience.tsx';
import Contact from '../components/sections/Contact.tsx';
---

<Layout>
  <Nav />
  <main id="main">
    <!-- Hero is server-rendered (HTML + reserved 100dvh height) so the
         headline paints immediately and nothing shifts below it. The heavy
         WebGL (ogl Aurora, Three.js Lanyard) is lazy()-imported inside, so
         SSR never touches WebGL — it hydrates after the static content. -->
    <Hero client:load />
    <!-- Work uses Motion (TiltedCard) + GSAP (AnimatedContent). client:visible defers JS until scrolled near. -->
    <Work client:visible />
    <About client:visible />
    <Experience client:visible />
    <Contact client:visible />
  </main>
</Layout>
