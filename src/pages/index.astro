---
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
---

<Layout>
  <Nav />
  <main id="main">
    <section class="flex min-h-[100dvh] items-center px-6 md:px-12">
      <div class="mx-auto max-w-[1400px] w-full">
        <p class="eyebrow mb-8">Portfolio · Vancouver, BC</p>
        <h1 class="font-display font-light leading-[0.95] tracking-tight" style="font-size: var(--text-display-1);">
          A polyglot<br />engineer<span class="text-accent">.</span>
        </h1>
        <p class="mt-10 max-w-2xl text-lg text-muted-fg md:text-xl">
          Shipping software, hardware, and the swarms in between.
          Hero, sections, animations — landing on this canvas next.
        </p>
      </div>
    </section>
  </main>
</Layout>
